# ============================================================
#  Course Agent · Git 忽略规则
#  重点：1.7GB 课程资源、数据库、密钥一律不入仓库
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/

# ---------- 环境变量 / 密钥 ----------
.env
.env.*
!.env.example
*.key
*.pem

# ---------- 数据库 ----------
backend/app/data/*.db
backend/app/data/*.db-*
backend/app/data/*.db.bak.*
backend/app/data/*.sqlite
backend/app/data/*.sqlite3
# 交付基准备份需要入仓库，供团队恢复初始状态
!backend/app/data/course_agent.db.bak.final_delivery

# ---------- 向量库 / AI 索引（由 P1 生成，不入仓库） ----------
backend/app/data/vector/
*.faiss
*.index

# ---------- 课程资源（1.7GB，禁止入仓库！） ----------
assets/resources/data-structures-1-9/
assets/resources/covers/
assets/resources/uploads/*
!assets/resources/uploads/.gitkeep

# ---------- 日志 ----------
*.log
logs/

# ---------- 测试产物 ----------
.pytest_cache/
backend/tests/results/
backend/tests/*.png
!backend/tests/e2e_smoke.js

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------- Node（仅测试用） ----------
node_modules/
package-lock.json
