# ============================================================
#  Course Agent · 环境变量模板（唯一有效模板）
# ------------------------------------------------------------
#  本文件与 config.py 同目录（backend/app/），是运行时实际加载的
#  配置位置。用法：复制为同目录 .env 并填写真实值
#        cp .env.example .env
#
#  注意：.env 已在 .gitignore 中，不会提交到仓库；
#        团队成员请各自本地创建，LLM/EMBEDDING 密钥找管理员获取。
# ============================================================

# ---------- JWT 鉴权 ----------
# 生产/团队协作必须设置固定值，否则每次启动随机生成 → 重启后所有登录态失效
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=请填入32字节十六进制随机串_全团队保持一致

# ---------- CORS 跨域 ----------
# 开发环境
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# 生产环境示例（前后端分离时填写前端域名）
# CORS_ORIGINS=https://your-frontend-domain.com

# ---------- LLM 大模型（智能答疑 / 智能出题） ----------
# OpenAI 兼容接口：DeepSeek / 硅基流动 / 通义 等
# 留空 LLM_API_KEY 时进入演示模式（真实检索题库，不调用大模型）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# ---------- 教师联网备课（教师专用，不开放给学生或管理员） ----------
# auto：已配置官方 DeepSeek 地址与 LLM_API_KEY 时直接复用；其他模型使用 Tavily。
# 可显式填写 deepseek 或 tavily；不会在请求失败后悄悄切换供应商。
TEACHER_WEB_SEARCH_ENABLED=true
TEACHER_WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
TEACHER_WEB_SEARCH_TIMEOUT=15
TEACHER_WEB_SEARCH_MAX_RESULTS=5
TEACHER_WEB_SEARCH_MAX_CALLS=2
TEACHER_WEB_READ_MAX_SOURCES=6
TEACHER_WEB_READ_BUDGET_SECONDS=90
TEACHER_WEB_PDF_ENABLED=true
TEACHER_WEB_PDF_MAX_MB=15
TEACHER_WEB_PDF_MAX_PAGES=8
TEACHER_WEB_QUESTION_DEDUP_ENABLED=true

# ---------- Embedding 向量化（RAG 检索） ----------
# 留空 EMBEDDING_API_KEY 时使用本地哈希向量（local-hash-256，无需外网）；
# 更换模型后请运行 python run_st_ingest.py <course_id> 重建向量（内置漂移自愈）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 调试 ----------
# 生产环境务必设为 False（关闭 SQL 日志与错误栈外泄）
# DEBUG=False
