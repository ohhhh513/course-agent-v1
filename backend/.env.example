# ============================================================
#  Course Agent · 环境变量模板
# ------------------------------------------------------------
#  用法：复制为 .env 并填写真实值
#        cp .env.example .env
#
#  注意：.env 已在 .gitignore 中，不会提交到仓库。
#        团队成员请各自本地创建，JWT_SECRET 需保持一致。
# ============================================================

# ---------- JWT 鉴权 ----------
# 生产/团队协作必须设置固定值，否则每次启动随机生成 → 重启后所有登录态失效
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=请填入32字节十六进制随机串_全团队保持一致

# ---------- CORS 跨域 ----------
# 开发环境
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# 生产环境示例（前后端分离时填写前端域名）
# CORS_ORIGINS=https://your-frontend-domain.com

# ============================================================
#  以下为 AI Agent 模块（P1 负责）预留，当前未启用
# ============================================================

# ---------- LLM 大模型 ----------
# 可选：qwen（通义千问）| glm（智谱）| deepseek | openai
# LLM_PROVIDER=qwen
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=3

# ---------- Embedding 向量化 ----------
# 留空则使用 LLM 同厂商的 embedding 服务
# EMBEDDING_PROVIDER=qwen
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_API_KEY=

# ---------- RAG 参数 ----------
# 检索返回的文档片段数
# RAG_TOP_K=4
# 文档切分块大小（字符）
# RAG_CHUNK_SIZE=800
# 文档切分重叠（字符）
# RAG_CHUNK_OVERLAP=120
# 向量库存储路径（相对 backend）
# RAG_VECTOR_DIR=app/data/vector

# ---------- 调试 ----------
# 生产环境务必设为 False（关闭 SQL 日志与错误栈外泄）
# DEBUG=False
